{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/fleet/tsconfig.app.json"
    },
    {
      "path": "./apps/booking/tsconfig.app.json"
    },
    {
      "path": "./apps/telemetry/tsconfig.app.json"
    },
    {
      "path": "./apps/billing/tsconfig.app.json"
    },
    {
      "path": "./apps/notification/tsconfig.app.json"
    }
  ]
}