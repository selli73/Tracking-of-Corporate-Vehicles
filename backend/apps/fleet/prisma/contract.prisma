// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int   @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Company {
  id                String @id @default(uuid())
  officialName      String @unique
  shortName         String
  tin               String @unique
  registeredAddress String
  actualAddress     String? 
  phone             String
  email             String 
  vehicles          Vehicle[]
  createdAt         temporal.createdAtString()
  updatedAt         temporal.updatedAtString()
}

model Vehicle {
  id           String      @id @default(uuid())
  brand        String
  model        String
  vin          String @unique
  licensePlate String @unique
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id]) 
  status       StatusVehicle @default(ACTIVE)
  createdAt    temporal.createdAtString()
  updatedAt    temporal.updatedAtString()

  @@index([companyId, status])
}

enum StatusVehicle {
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}
