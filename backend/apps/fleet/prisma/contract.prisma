// use prisma-8

model User {
  id                       String     @id      @default(uuid())
  email                    String     @unique
  passwordHash             String  
  name                     String
  surname                  String
  role                     Role
  dismissed                Boolean   @default(false)
  driverLicenseNumber      String?
  driverLicenseExpiresAt   String?
  companyId                String
  company                  Company   @relation(fields: [companyId], references: [id])
  createdAt                temporal.createdAtString()
  updatedAt                temporal.updatedAtString()  

  @@index([email])
  @@index([companyId, role])  
}

enum Role {
  MANAGER
  DRIVER
  COMPANY_ADMIN
  OWNER
}

model Company {
  id                String @id @default(uuid())
  officialName      String @unique
  shortName         String
  tin               String @unique
  registeredAddress String
  actualAddress     String?   
  phone             String
  email             String 
  vehicles          Vehicle[]
  users             User[]
  createdAt         temporal.createdAtString()
  updatedAt         temporal.updatedAtString()
}

model Vehicle {
  id           String      @id @default(uuid())
  brand        String
  model        String
  vin          String @unique
  licensePlate String @unique
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id]) 
  status       StatusVehicle @default(ACTIVE)
  createdAt    temporal.createdAtString()
  updatedAt    temporal.updatedAtString()

  @@index([companyId, status])
}

enum StatusVehicle {
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}
