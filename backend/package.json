{
  "name": "tracking-vehicles",
  "type": "module",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/tracking-vehicles/main",
    "lint": "oxlint src/ test/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/tracking-vehicles/test/jest-e2e.json",
    "contract:emit": "prisma contract emit",
    "gateway:db:emit": "prisma contract emit --config apps/gateway/prisma.config.ts",
    "gateway:db:init": "prisma db init --config apps/gateway/prisma.config.ts",
    "fleet:db:emit": "prisma contract emit --config apps/fleet/prisma.config.ts",
    "fleet:db:init": "prisma db init --config apps/fleet/prisma.config.ts",
    "booking:db:emit": "prisma contract emit --config apps/booking/prisma.config.ts",
    "booking:db:init": "prisma db init --config apps/booking/prisma.config.ts",
    "telemetry:db:emit": "prisma contract emit --config apps/telemetry/prisma.config.ts",
    "telemetry:db:init": "prisma db init --config apps/telemetry/prisma.config.ts",
    "billing:db:emit": "prisma contract emit --config apps/billing/prisma.config.ts",
    "billing:db:init": "prisma db init --config apps/billing/prisma.config.ts",
    "notification:db:emit": "prisma contract emit --config apps/notification/prisma.config.ts",
    "notification:db:init": "prisma db init --config apps/notification/prisma.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "@rspack/core": "^2.2.6",
    "dotenv": "^18.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "webpack-node-externals": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/cli-engine": "0.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^8.0.0-rc.15",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}